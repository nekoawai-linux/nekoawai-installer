#!/bin/bash
# NekoAwai installer.
#
# Puts the base system on a UEFI machine: partitions, filesystems, the base
# pattern, the bootloader. Anything beyond that list is configured in the
# installed system, not here.

set -Eeuo pipefail

# The installer reads the output of parted, zypper and cryptsetup, and the
# Live console carries no font beyond the built-in one. A single locale for
# the whole run keeps both the log and the screen readable whatever the
# environment asks for.
export LC_ALL=C.UTF-8

TARGET=/mnt
ESP_SIZE=512MiB
VERSION=0.3.1
INSTALL_LOG=/tmp/nekoawai-install.log

# Where the nekoawai-* packages live on the installation medium. Until
# there is a public build, they come from here.
: "${NEKO_TARGET_REPO:=${NEKO_LOCAL_REPO:-/run/nekoawai/repo}}"
: "${NEKO_CORE_REPO:=http://download.opensuse.org/tumbleweed/repo/oss/}"
: "${NEKO_DETECT_GPU:=yes}"
# The Live system carries packages, not a package list, and no repository of
# its own. Package search needs one, so it gets a root to keep it in; on the
# Live medium that root is memory and disappears with the session.
: "${NEKO_INDEX_ROOT:=/var/tmp/nekoawai-index}"

DISK=
DISK_LABEL=
ESP_PART=
ROOT_PART=
ROOT_DEV=
ROOT_UUID=
ROOT_PART_UUID=
ESP_UUID=
FSTYPE=
ENCRYPT=no
HOSTNAME=
LOCALE=
KEYMAP=
TIMEZONE=
PROFILE=minimal
DESKTOP=
SWAP_MODE=zram
SWAP_SIZE=4G
NETWORK_MODE=automatic
ENABLE_SSH=no
ADDITIONAL_PACKAGES=
ROOT_LOCKED=no
ROOT_PASSWORD=
LUKS_PASSPHRASE=
TUI=no
GPU_PACKAGES=
STEP_INDEX=0
STEP_TOTAL=0

declare -a USER_NAMES=()
declare -a USER_PASSWORDS=()
declare -a USER_WHEEL=()

# In a terminal the step heading comes from run_step, and printing both
# leaves every step named twice.
log() { [ "$TUI" = yes ] || printf '\n>>> %s\n' "$*"; }
die() {
	printf 'error: %s\n' "$*" >&2
	exit 1
}

ask() {
	local prompt=$1 default=${2:-} answer
	read -r -p "$prompt${default:+ [$default]}: " answer
	printf '%s' "${answer:-$default}"
}

ask_secret() {
	local prompt=$1 first second
	# Everything but the answer goes to stderr: the caller reads the value
	# through command substitution, so anything on stdout would end up
	# inside the password.
	while :; do
		read -r -s -p "$prompt: " first; echo >&2
		read -r -s -p "repeat: " second; echo >&2
		if [ -n "$first" ] && [ "$first" = "$second" ]; then
			break
		fi
		echo "empty or does not match" >&2
	done
	printf '%s' "$first"
}

# The screens are drawn here rather than handed to a widget library: the
# Live console has the built-in font and nothing else, and a full-screen
# list reads the same on it as it does in a terminal emulator.
TUI_BRAND=$'\033[1;35m'
TUI_DIM=$'\033[2m'
TUI_SELECTED=$'\033[7m'
TUI_OK=$'\033[1;32m'
TUI_WARN=$'\033[1;33m'
TUI_PLAIN=$'\033[0m'
TUI_RULE=------------------------------------------------------------------------

# One line of hint text per menu entry, keyed by tag. Set it right before the
# tui_menu call that needs it; the menu takes the hints and clears them, so
# nothing leaks into the next screen.
declare -A TUI_HINT=()

tui_screen() {
	printf '\033[2J\033[H%s NekoAwai Installer %s %s=^..^=%s\n%s %s%s\n\n' \
		"$TUI_BRAND" "$VERSION" "$TUI_DIM" "$TUI_PLAIN" \
		"$TUI_DIM" "$TUI_RULE" "$TUI_PLAIN"
	[ -z "${1:-}" ] || printf '%s\n\n' "$1"
}

# Arrow keys arrive as three bytes, Enter as an empty read; anything the
# menu does not understand leaves the selection where it was.
tui_key() {
	local key tail
	KEY=other
	IFS= read -rsn1 key || { KEY=escape; return; }
	case $key in
	'') KEY=enter ;;
	' ') KEY=space ;;
	/) KEY=search ;;
	k) KEY=up ;;
	j) KEY=down ;;
	$'\033')
		IFS= read -rsn2 -t 0.05 tail || tail=
		case $tail in
		'[A') KEY=up ;;
		'[B') KEY=down ;;
		'') KEY=escape ;;
		esac
		;;
	esac
}

# Tag and label pairs, as dialog took them; the chosen tag lands in REPLY.
# Leaving with Esc returns non-zero and REPLY keeps its previous value, so a
# cancelled submenu changes no setting.
tui_menu() {
	local caption=$1 index=0 last width=0 position key hint
	shift
	local -a tags=() labels=()
	local -A hints=()
	while [ "$#" -gt 1 ]; do
		tags+=("$1")
		labels+=("$2")
		shift 2
	done
	last=$(( ${#tags[@]} - 1 ))
	for position in "${!labels[@]}"; do
		[ "${#labels[$position]}" -le "$width" ] || width=${#labels[$position]}
	done
	for key in "${!TUI_HINT[@]}"; do hints[$key]=${TUI_HINT[$key]}; done
	TUI_HINT=()

	while :; do
		tui_screen "$caption"
		for position in "${!tags[@]}"; do
			if [ "$position" -eq "$index" ]; then
				printf '%s > %-*s %s\n' \
					"$TUI_SELECTED" "$width" "${labels[$position]}" "$TUI_PLAIN"
			else
				printf '   %-*s \n' "$width" "${labels[$position]}"
			fi
		done
		hint=${hints[${tags[$index]}]:-}
		[ -z "$hint" ] || printf '\n%s   %s%s\n' "$TUI_DIM" "$hint" "$TUI_PLAIN"
		printf '\n%sup/down choose, enter confirm, esc back%s\n' \
			"$TUI_DIM" "$TUI_PLAIN"

		tui_key
		case $KEY in
		up) [ "$index" -gt 0 ] && index=$(( index - 1 )) || index=$last ;;
		down) [ "$index" -lt "$last" ] && index=$(( index + 1 )) || index=0 ;;
		enter) REPLY=${tags[$index]}; return 0 ;;
		escape) return 1 ;;
		esac
	done
}

# The safe answer comes first unless the caller asks otherwise.
tui_confirm() {
	if [ "${2:-no}" = yes ]; then
		tui_menu "$1" yes "Yes" no "No" || return 1
	else
		tui_menu "$1" no "No" yes "Yes" || return 1
	fi
	[ "$REPLY" = yes ]
}

tui_message() {
	tui_screen "$1"
	printf '%spress enter to continue%s' "$TUI_DIM" "$TUI_PLAIN"
	read -r _ || :
}

tui_input() {
	local title=$1 prompt=$2 default=${3:-}
	tui_screen "$title"
	printf '\033[?25h'
	read -r -p "$prompt${default:+ [$default]}: " REPLY || REPLY=
	printf '\033[?25l'
	[ -n "$REPLY" ] || REPLY=$default
}

tui_password() {
	local title=$1 first second
	while :; do
		tui_screen "$title"
		read -r -s -p "Password: " first; echo
		read -r -s -p "Repeat: " second; echo
		if [ -n "$first" ] && [ "$first" = "$second" ]; then
			REPLY=$first
			return 0
		fi
		tui_message "Passwords are empty or do not match."
	done
}

select_disk_tui() {
	local line size model
	local -a items=()
	while IFS= read -r line; do
		items+=("${line%% *}" "$line")
	done < <(lsblk -dnpo NAME,SIZE,MODEL -e 7,11)

	[ "${#items[@]}" -gt 0 ] || { tui_message "No installation disks found."; return; }
	if tui_menu "Select a disk. It is erased only after the confirmation." \
		"${items[@]}"; then
		DISK=$REPLY
		read -r size model < <(lsblk -dno SIZE,MODEL "$DISK") || :
		DISK_LABEL="$size${model:+ $model}"
	fi
}

select_profile_tui() {
	TUI_HINT=(
		[minimal]="Console only: the base system, no graphics."
		[desktop]="Adds graphics, audio, fonts and a login screen."
	)
	if ! tui_menu "System type" \
		minimal "Minimal CLI system" \
		desktop "Graphical system"; then
		return
	fi
	PROFILE=$REPLY
	if [ "$PROFILE" = minimal ]; then
		DESKTOP=
		return
	fi
	TUI_HINT=(
		[niri]="Scrolling tiles on Wayland, with LightDM. Keyboard driven."
		[hyprland]="Tiling Wayland compositor with animations, with SDDM."
		[gnome]="The full GNOME session on Wayland, with GDM."
		[plasma]="KDE Plasma on Wayland, with SDDM. Configurable to the bone."
		[xfce]="A classic desktop on Xorg, with LightDM. Light and familiar."
	)
	if tui_menu "Choose one desktop" \
		niri "Niri" \
		hyprland "Hyprland" \
		gnome "GNOME" \
		plasma "KDE Plasma" \
		xfce "Xfce"; then
		DESKTOP=$REPLY
	fi
}

select_storage_tui() {
	TUI_HINT=(
		[ext4]="Plain and predictable."
		[btrfs]="Subvolumes, compression and snapshots later on."
	)
	if tui_menu "Root filesystem" ext4 "ext4" btrfs "btrfs with an @ subvolume"; then
		FSTYPE=$REPLY
	fi
	if tui_confirm "Encrypt the root partition with LUKS2?"; then
		ENCRYPT=yes
		if tui_password "LUKS2 passphrase"; then
			LUKS_PASSPHRASE=$REPLY
		else
			ENCRYPT=no
			LUKS_PASSPHRASE=
		fi
	else
		ENCRYPT=no
		LUKS_PASSPHRASE=
	fi
}

select_swap_tui() {
	TUI_HINT=(
		[zram]="Compressed swap in memory. Takes no disk and suits an encrypted root."
		[swapfile]="A file on the root filesystem. Needed for hibernation."
		[none]="Nothing to fall back on when memory runs out."
	)
	if ! tui_menu "Swap mode" \
		zram "Compressed swap in RAM" \
		swapfile "Swap file on the root filesystem" \
		none "No swap"; then
		return
	fi
	SWAP_MODE=$REPLY
	if [ "$SWAP_MODE" = swapfile ] && \
		tui_input "Swap file" "Size: a number with an M or G suffix" "$SWAP_SIZE"; then
		SWAP_SIZE=$REPLY
	fi
}

configure_identity_tui() {
	if tui_input "Machine name" "Hostname" "${HOSTNAME:-nekoawai}"; then HOSTNAME=$REPLY; fi
	if tui_input "Locale" "System locale" "${LOCALE:-en_US.UTF-8}"; then LOCALE=$REPLY; fi
	if tui_input "Keyboard" "Console keymap" "${KEYMAP:-us}"; then KEYMAP=$REPLY; fi
	if tui_input "Time zone" "Timezone, for example Europe/Samara" "${TIMEZONE:-UTC}"; then TIMEZONE=$REPLY; fi
}

add_user_tui() {
	local name wheel=no existing
	if ! tui_input "New user" "User name"; then return; fi
	name=$REPLY
	if ! [[ $name =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
		tui_message "Invalid user name: $name"
		return
	fi
	for existing in "${USER_NAMES[@]}"; do
		[ "$existing" != "$name" ] || { tui_message "User $name is already on the list."; return; }
	done
	if ! tui_password "Password for $name"; then return; fi
	local password=$REPLY
	if tui_confirm "Add $name to the wheel group?" yes; then
		wheel=yes
	fi
	USER_NAMES+=("$name")
	USER_PASSWORDS+=("$password")
	USER_WHEEL+=("$wheel")
}

delete_user_tui() {
	local index
	local -a items=()
	for index in "${!USER_NAMES[@]}"; do
		if [ "${USER_WHEEL[$index]}" = yes ]; then
			items+=("$index" "${USER_NAMES[$index]} (wheel)")
		else
			items+=("$index" "${USER_NAMES[$index]}")
		fi
	done
	[ "${#items[@]}" -gt 0 ] || { tui_message "There are no users to delete."; return; }
	if tui_menu "Select a user to delete" "${items[@]}"; then
		index=$REPLY
		unset 'USER_NAMES[index]' 'USER_PASSWORDS[index]' 'USER_WHEEL[index]'
		USER_NAMES=("${USER_NAMES[@]}")
		USER_PASSWORDS=("${USER_PASSWORDS[@]}")
		USER_WHEEL=("${USER_WHEEL[@]}")
	fi
}

configure_users_tui() {
	local choice
	while :; do
		TUI_HINT=(
			[root-password]="Kept for recovery: a locked root needs a user in wheel to get anything done."
			[root-lock]="No login as root at all. Administration then goes through sudo."
			[add]="The account for daily use. A desktop needs at least one."
			[delete]="Takes an account off the list. Nothing has been created yet."
		)
		if ! tui_menu "Root: $(root_state), regular users: ${#USER_NAMES[@]}" \
			root-password "Set the root password" \
			root-lock "Lock the root account" \
			add "Add a user" \
			delete "Delete a user" \
			back "Back"; then
			return
		fi
		choice=$REPLY
		case $choice in
		root-password)
			if tui_password "Root"; then ROOT_PASSWORD=$REPLY; ROOT_LOCKED=no; fi
			;;
		root-lock) ROOT_PASSWORD=; ROOT_LOCKED=yes ;;
		add) add_user_tui ;;
		delete) delete_user_tui ;;
		back) return ;;
		esac
	done
}

configure_network_tui() {
	TUI_HINT=(
		[automatic]="A wired network that hands out addresses needs nothing else."
		[copy]="Takes the Wi-Fi passwords entered here over to the new system."
		[nmtui]="Connect here first, then the connection is carried over."
	)
	if ! tui_menu "Networking in the installed system" \
		automatic "NetworkManager with automatic DHCP" \
		copy "Copy the connections of the Live system" \
		nmtui "Open nmtui, then copy the connections"; then
		return
	fi
	NETWORK_MODE=$REPLY
	if [ "$NETWORK_MODE" = nmtui ]; then
		nmtui
		NETWORK_MODE=copy
	fi
}

# Search results, package by package: name on the left, what the repository
# says about it on the right, and a mark for the ones already on the list.
search_packages_tui() {
	local query index top rows=12 last position name summary mark row again
	local -a names=() summaries=()

	while :; do
		tui_input "Package search" "Search for"
		query=$REPLY
		[ -n "$query" ] || return

		tui_screen "Looking for $query ..."
		if ! package_index; then
			tui_message "The package list could not be fetched. Check the network and try again."
			return
		fi
		names=()
		summaries=()
		while IFS=$'\t' read -r name summary; do
			names+=("$name")
			summaries+=("$summary")
		done < <(package_search "$query")
		if [ "${#names[@]}" -eq 0 ]; then
			tui_message "Nothing in the repositories matches $query."
			continue
		fi

		index=0
		top=0
		last=$(( ${#names[@]} - 1 ))
		again=no
		while [ "$again" = no ]; do
			[ "$index" -ge "$top" ] || top=$index
			[ "$index" -lt $(( top + rows )) ] || top=$(( index - rows + 1 ))
			tui_screen "$(printf '%s packages match %s. Marked ones are installed with the system.' \
				"${#names[@]}" "$query")"
			for (( position = top; position < top + rows && position <= last; position++ )); do
				mark=' '
				package_selected "${names[$position]}" && mark=x
				row=$(printf '[%s] %-28s %s' "$mark" "${names[$position]}" "${summaries[$position]}")
				if [ "$position" -eq "$index" ]; then
					printf '%s > %-74s %s\n' "$TUI_SELECTED" "${row:0:74}" "$TUI_PLAIN"
				else
					printf '   %s\n' "${row:0:74}"
				fi
			done
			printf '\n%son the list: %s%s\n' \
				"$TUI_DIM" "${ADDITIONAL_PACKAGES:-nothing yet}" "$TUI_PLAIN"
			printf '%sspace marks, / searches again, enter keeps the list, esc goes back%s\n' \
				"$TUI_DIM" "$TUI_PLAIN"

			tui_key
			case $KEY in
			up) [ "$index" -gt 0 ] && index=$(( index - 1 )) || index=$last ;;
			down) [ "$index" -lt "$last" ] && index=$(( index + 1 )) || index=0 ;;
			space) package_toggle "${names[$index]}" ;;
			search) again=yes ;;
			enter | escape) return ;;
			esac
		done
	done
}

configure_packages_tui() {
	while :; do
		TUI_HINT=(
			[search]="Type a word and pick from what the repositories actually have."
			[names]="For names you already know, separated by spaces."
			[clear]="Start the list over."
		)
		if ! tui_menu "Packages installed along with the system: ${ADDITIONAL_PACKAGES:-none}" \
			search "Search the repositories" \
			names "Type the names" \
			clear "Clear the list" \
			back "Back"; then
			return
		fi
		case $REPLY in
		search) search_packages_tui ;;
		names)
			tui_input "Additional packages" \
				"Exact package names separated by spaces. Leave empty if there are none." \
				"$ADDITIONAL_PACKAGES"
			ADDITIONAL_PACKAGES=$REPLY
			;;
		clear) ADDITIONAL_PACKAGES= ;;
		back) return ;;
		esac
	done
}

toggle_ssh_tui() {
	if [ "$ENABLE_SSH" = yes ]; then ENABLE_SSH=no; else ENABLE_SSH=yes; fi
}

root_state() {
	if [ "$ROOT_LOCKED" = yes ]; then
		printf 'locked'
	elif [ -n "$ROOT_PASSWORD" ]; then
		printf 'password set'
	else
		printf 'not set'
	fi
}

configuration_summary() {
	local users_text=none name index swap_text=$SWAP_MODE
	if [ "${#USER_NAMES[@]}" -gt 0 ]; then
		users_text=
		for index in "${!USER_NAMES[@]}"; do
			name=${USER_NAMES[$index]}
			[ "${USER_WHEEL[$index]}" != yes ] || name="$name (wheel)"
			users_text="${users_text:+$users_text, }$name"
		done
	fi
	[ "$SWAP_MODE" = swapfile ] && swap_text="swapfile ($SWAP_SIZE)"
	cat <<-EOF
		${TUI_BRAND}Disk${TUI_PLAIN}
		  Target       ${DISK:-not selected}${DISK_LABEL:+  ($DISK_LABEL)}
		  Filesystem   ${FSTYPE:-not selected}, LUKS2 $ENCRYPT
		  Swap         $swap_text

		${TUI_BRAND}System${TUI_PLAIN}
		  Profile      ${DESKTOP:-$PROFILE}
		  Hostname     ${HOSTNAME:-not set}
		  Locale       ${LOCALE:-not set}, keymap ${KEYMAP:-not set}
		  Time zone    ${TIMEZONE:-not set}
		  Packages     ${ADDITIONAL_PACKAGES:-none beyond the profile}

		${TUI_BRAND}Accounts and network${TUI_PLAIN}
		  Users        $users_text
		  Root         $(root_state)
		  Network      $NETWORK_MODE
		  SSH          $ENABLE_SSH
	EOF
}

# The Live system has no repositories of its own: the medium carries the
# packages of the distribution, and everything else is fetched during the
# install. So searching means keeping a package list somewhere, and it goes
# into a root of its own rather than into whatever system the installer
# happens to run on. Fetched once, on the first search.
#
# ponytail: the install downloads the same metadata again into the target.
# Sharing one cache between the two is a --cache-dir away if the second
# download starts to hurt.
package_index() {
	[ ! -f "$NEKO_INDEX_ROOT/etc/zypp/repos.d/nekoawai-index.repo" ] || return 0
	[ "$TUI" != yes ] || tui_screen "Fetching the package list. This happens once and needs the network."
	install -dm 0755 "$NEKO_INDEX_ROOT"
	{
		zypper --root "$NEKO_INDEX_ROOT" --non-interactive --gpg-auto-import-keys \
			addrepo --refresh "$NEKO_CORE_REPO" nekoawai-index &&
		if [ -d "$NEKO_TARGET_REPO" ]; then
			zypper --root "$NEKO_INDEX_ROOT" --non-interactive \
				addrepo --no-gpgcheck --priority 90 \
				"dir:$NEKO_TARGET_REPO" nekoawai-index-local
		fi &&
		zypper --root "$NEKO_INDEX_ROOT" --non-interactive --gpg-auto-import-keys refresh
	} >> "$INSTALL_LOG" 2>&1 && return 0

	# A half-built index would be taken for a finished one on the next call.
	rm -rf "$NEKO_INDEX_ROOT"
	return 1
}

# Name and summary of every package matching the term, as zypper prints them
# in its table. The list stops at 200: past that the screen is a haystack and
# a narrower search is the answer.
package_search() {
	zypper --root "$NEKO_INDEX_ROOT" --non-interactive --no-refresh \
		search --type package -- "$1" 2>/dev/null |
		awk -F' *\\| *' '
			/^-+\+/ { body = 1; next }
			body && NF >= 3 && $2 != "" { print $2 "\t" $3 }
		' | head -n 200
}

package_selected() {
	case " $ADDITIONAL_PACKAGES " in
	*" $1 "*) return 0 ;;
	esac
	return 1
}

package_toggle() {
	local wanted=$1 package kept=
	if ! package_selected "$wanted"; then
		ADDITIONAL_PACKAGES="${ADDITIONAL_PACKAGES:+$ADDITIONAL_PACKAGES }$wanted"
		return
	fi
	for package in $ADDITIONAL_PACKAGES; do
		[ "$package" = "$wanted" ] || kept="${kept:+$kept }$package"
	done
	ADDITIONAL_PACKAGES=$kept
}

package_available() {
	local wanted=$1 rpm
	for rpm in "$NEKO_TARGET_REPO"/*.rpm; do
		[ -e "$rpm" ] || break
		[ "$(rpm -qp --qf '%{NAME}' "$rpm" 2>/dev/null)" != "$wanted" ] || return 0
	done
	package_index || return 1
	zypper --root "$NEKO_INDEX_ROOT" --non-interactive --no-refresh --xmlout \
		search --match-exact --type package "$wanted" 2>/dev/null |
		grep -q "name=\"$wanted\""
}

# The first problem in menu order is the one worth showing: it is the one
# the user reaches first, and a later check must not talk over it.
problem() { [ -n "$VALIDATION_ERROR" ] || VALIDATION_ERROR=$1; }

# Without an argument the checks stay local, so the menu can run them on
# every redraw. `full` also asks the repositories, which costs a package list
# and belongs to the moment before the disk is erased.
validate_configuration() {
	local depth=${1:-local} name package has_admin=no
	local profile_package=patterns-nekoawai-base
	VALIDATION_ERROR=
	[ -n "$DISK" ] && [ -b "$DISK" ] || problem "Select an installation disk."
	# Quiet: the menu runs these checks on every redraw, and a disk that has
	# been unplugged must not write over the screen.
	if [ -n "$DISK" ] && lsblk -nrpo MOUNTPOINT "$DISK" 2>/dev/null | grep -q '[^[:space:]]'; then
		problem "There are mounted filesystems on $DISK."
	fi
	case $FSTYPE in
	ext4 | btrfs) ;;
	*) problem "Select a filesystem: ext4 or btrfs." ;;
	esac
	[ "$ENCRYPT" != yes ] || [ -n "$LUKS_PASSPHRASE" ] || problem "Set the LUKS2 passphrase."
	[ "$SWAP_MODE" != swapfile ] || [[ $SWAP_SIZE =~ ^[1-9][0-9]*[MG]$ ]] || \
		problem "The swap file size has to look like 4096M or 4G."
	[ "$PROFILE" != desktop ] || [ -n "$DESKTOP" ] || problem "Select a desktop."
	[ "$PROFILE" != desktop ] || profile_package="patterns-nekoawai-$DESKTOP"
	[[ ${HOSTNAME:-} =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]{0,62}$ ]] || problem "Invalid hostname."
	[ -n "$LOCALE" ] || problem "Set the locale."
	[ -n "$KEYMAP" ] || problem "Set the console keymap."
	[ -f "/usr/share/zoneinfo/${TIMEZONE:-}" ] || problem "Unknown time zone: ${TIMEZONE:-empty}."

	for name in "${USER_WHEEL[@]}"; do [ "$name" != yes ] || has_admin=yes; done
	if [ "$PROFILE" = desktop ] && [ "${#USER_NAMES[@]}" -eq 0 ]; then
		problem "A desktop needs at least one regular user."
	fi
	if [ "$ROOT_LOCKED" != yes ] && [ -z "$ROOT_PASSWORD" ]; then
		problem "Set the root password or lock the root account."
	fi
	if [ "$ROOT_LOCKED" = yes ] && [ "${#USER_NAMES[@]}" -eq 0 ]; then
		problem "Root cannot be locked without a regular user."
	fi
	if [ "$ENABLE_SSH" = yes ] && [ "$has_admin" != yes ]; then
		problem "SSH needs a user in the wheel group."
	fi

	for package in $ADDITIONAL_PACKAGES; do
		[[ $package =~ ^[A-Za-z0-9@._+:-]+$ ]] || problem "Invalid package name: $package"
	done

	if [ "$depth" = full ] && [ -z "$VALIDATION_ERROR" ]; then
		if [ -n "$DESKTOP" ] || [ "$PROFILE" = minimal ]; then
			package_available "$profile_package" ||
				problem "Profile not found in the repositories: $profile_package"
		fi
		for package in $ADDITIONAL_PACKAGES; do
			package_available "$package" ||
				problem "Package not found in the repositories: $package"
		done
	fi

	[ -z "$VALIDATION_ERROR" ]
}

confirm_install_tui() {
	tui_screen "Checking the configuration ..."
	if ! validate_configuration full; then
		tui_message "$VALIDATION_ERROR"
		return 1
	fi
	tui_menu "$(configuration_summary)" \
		back "Back to the menu" \
		continue "Continue" || return 1
	[ "$REPLY" = continue ] || return 1

	# The last screen before the disk is written to says which disk it is, by
	# name and by what is printed on it.
	tui_menu "ALL DATA ON $DISK${DISK_LABEL:+ ($DISK_LABEL)} WILL BE DESTROYED.
Partitions, filesystems and everything on them are gone after this." \
		back "Cancel" \
		wipe "Erase $DISK and install" || return 1
	[ "$REPLY" = wipe ]
}

# Menu rows carry a name and the value currently set for it.
tui_row() { printf '%-16s %s' "$1" "$2"; }

configure_tui() {
	local choice status
	HOSTNAME=${HOSTNAME:-nekoawai}
	LOCALE=${LOCALE:-en_US.UTF-8}
	KEYMAP=${KEYMAP:-us}
	TIMEZONE=${TIMEZONE:-UTC}

	# The menus hide the cursor, and a shell left without one looks broken.
	trap 'printf "\033[?25h"' EXIT
	printf '\033[?25l'

	while :; do
		# What is still missing, on the screen where it can be fixed, rather
		# than at the end as a refusal to install.
		if validate_configuration; then
			status="${TUI_OK}Ready to install.${TUI_PLAIN}"
		else
			status="${TUI_WARN}Still missing: $VALIDATION_ERROR${TUI_PLAIN}"
		fi
		TUI_HINT=(
			[disk]="The disk that gets erased. Nothing is written before the last confirmation."
			[storage]="The filesystem of the root partition, and whether it is encrypted."
			[profile]="A console system, or one of five desktops with everything they need."
			[swap]="Where the system swaps when it runs out of memory."
			[identity]="Machine name, locale, console keymap and time zone."
			[users]="Everyday accounts, and what happens to root."
			[ssh]="Whether sshd listens after the first boot. Needs a user in wheel."
			[network]="How the installed system gets back on the network."
			[packages]="Anything to install along with the profile."
			[install]="Shows the whole configuration first. The disk survives until you confirm."
			[quit]="Leaves every disk as it is."
		)
		if ! tui_menu "Configure the system, then choose Install."$'\n'"$status" \
			disk "$(tui_row Disk "${DISK:-not selected}${DISK_LABEL:+, $DISK_LABEL}")" \
			storage "$(tui_row Storage "${FSTYPE:-not selected}, LUKS2 $ENCRYPT")" \
			profile "$(tui_row Profile "${DESKTOP:-$PROFILE}")" \
			swap "$(tui_row Swap "$SWAP_MODE")" \
			identity "$(tui_row System "$HOSTNAME, $LOCALE, $TIMEZONE")" \
			users "$(tui_row Users "${#USER_NAMES[@]}, root $(root_state)")" \
			network "$(tui_row Network "$NETWORK_MODE")" \
			ssh "$(tui_row SSH "$ENABLE_SSH")" \
			packages "$(tui_row Packages "${ADDITIONAL_PACKAGES:-none}")" \
			install "Install" \
			quit "Quit"; then
			die "installation cancelled"
		fi
		choice=$REPLY
		case $choice in
		disk) select_disk_tui ;;
		storage) select_storage_tui ;;
		profile) select_profile_tui ;;
		swap) select_swap_tui ;;
		identity) configure_identity_tui ;;
		users) configure_users_tui ;;
		network) configure_network_tui ;;
		ssh) toggle_ssh_tui ;;
		packages) configure_packages_tui ;;
		install) confirm_install_tui && break ;;
		quit) die "installation cancelled" ;;
		esac
	done

	printf '\033[?25h'
}

partition_path() {
	local disk=$1 number=$2
	# nvme0n1 -> nvme0n1p1, sda -> sda1
	case $disk in
	*[0-9]) printf '%sp%s' "$disk" "$number" ;;
	*) printf '%s%s' "$disk" "$number" ;;
	esac
}

require_uefi_root() {
	[ "$(id -u)" -eq 0 ] || die "root privileges are required"
	[ -d /sys/firmware/efi ] || die "0.0.1 installs on UEFI machines only"
}

select_disk() {
	log "available disks"
	lsblk -dno NAME,SIZE,MODEL -e 7,11
	DISK=/dev/$(ask "disk to install on (without /dev/)")
	[ -b "$DISK" ] || die "$DISK is not a block device"
}

select_layout() {
	FSTYPE=$(ask "root filesystem (ext4/btrfs)" ext4)
	case $FSTYPE in
	ext4 | btrfs) ;;
	*) die "0.0.1 supports ext4 and btrfs only" ;;
	esac
	ENCRYPT=$(ask "encrypt the root with LUKS2 (yes/no)" no)
}

confirm_wipe() {
	log "ALL DATA ON $DISK WILL BE DESTROYED"
	[ "$(ask "type yes to continue")" = yes ] || die "cancelled"
}

partition_disk() {
	log "partitioning $DISK"
	wipefs -a "$DISK"
	parted -s "$DISK" mklabel gpt
	parted -s "$DISK" mkpart ESP fat32 1MiB "$ESP_SIZE"
	parted -s "$DISK" set 1 esp on
	parted -s "$DISK" mkpart root "$ESP_SIZE" 100%
	udevadm settle

	ESP_PART=$(partition_path "$DISK" 1)
	ROOT_PART=$(partition_path "$DISK" 2)

	# A fresh partition table does not erase what lies inside the partitions.
	# A reinstall puts them back at the same offsets, and mkfs and luksFormat
	# both stop at the signature of the previous system found there.
	wipefs -a "$ESP_PART" "$ROOT_PART"
}

open_encrypted_root() {
	[ "$ENCRYPT" = yes ] || { ROOT_DEV=$ROOT_PART; return; }

	log "encrypting the root"
	local passphrase=$LUKS_PASSPHRASE
	[ -n "$passphrase" ] || passphrase=$(ask_secret "LUKS2 passphrase")
	printf '%s' "$passphrase" | cryptsetup luksFormat --type luks2 --batch-mode "$ROOT_PART" -
	printf '%s' "$passphrase" | cryptsetup open "$ROOT_PART" cr_root -
	passphrase=
	LUKS_PASSPHRASE=
	ROOT_DEV=/dev/mapper/cr_root
}

format_filesystems() {
	log "creating filesystems"
	mkfs.vfat -F32 -n EFI "$ESP_PART"
	case $FSTYPE in
	ext4) mkfs.ext4 -q -L nekoawai "$ROOT_DEV" ;;
	btrfs) mkfs.btrfs -q -L nekoawai "$ROOT_DEV" ;;
	esac
}

mount_target() {
	log "mounting $TARGET"
	if [ "$FSTYPE" = btrfs ]; then
		# The @ subvolume leaves room for root snapshots without a
		# reinstall.
		mount "$ROOT_DEV" "$TARGET"
		btrfs subvolume create "$TARGET/@" >/dev/null
		umount "$TARGET"
		mount -o subvol=@ "$ROOT_DEV" "$TARGET"
	else
		mount "$ROOT_DEV" "$TARGET"
	fi
	mkdir -p "$TARGET/boot/efi"
	# Same permissions fstab will use: otherwise the bootloader drops its
	# random seed onto a world-readable partition and complains.
	mount -o umask=0077 "$ESP_PART" "$TARGET/boot/efi"

	ROOT_UUID=$(blkid -s UUID -o value "$ROOT_DEV")
	ROOT_PART_UUID=$(blkid -s UUID -o value "$ROOT_PART")
	ESP_UUID=$(blkid -s UUID -o value "$ESP_PART")
}

detect_gpu_packages() {
	local device class vendor package packages=" "
	[ "$PROFILE" = desktop ] && [ "$NEKO_DETECT_GPU" = yes ] || return 0
	for device in /sys/bus/pci/devices/*; do
		[ -r "$device/class" ] && [ -r "$device/vendor" ] || continue
		read -r class < "$device/class"
		[[ $class = 0x03* ]] || continue
		read -r vendor < "$device/vendor"
		case $vendor in
		0x8086) package=libvulkan_intel ;;
		0x1002) package=libvulkan_radeon ;;
		0x10de) package=libvulkan_nouveau ;;
		*) continue ;;
		esac
		case $packages in *" $package "*) ;; *) packages="$packages$package " ;; esac
	done
	GPU_PACKAGES=${packages# }
	GPU_PACKAGES=${GPU_PACKAGES% }
}

normalize_gpu_packages() {
	local package
	local selected=" $GPU_PACKAGES "
	local -a remove=()
	# Nothing recognised means a virtual machine or a card we do not know
	# yet, and there the profile knows better than this function. Pruning on
	# an empty detection took Mesa off the target, and the desktop with it.
	[ -n "$GPU_PACKAGES" ] || return 0
	for package in libvulkan_intel libvulkan_radeon libvulkan_nouveau; do
		case $selected in
		*" $package "*) continue ;;
		esac
		rpm --root "$TARGET" -q "$package" >/dev/null 2>&1 && remove+=("$package")
	done
	[ "${#remove[@]}" -gt 0 ] || return 0
	# The drivers share their dependencies with the rest of Mesa, so cleaning
	# up after them removes far more than the driver.
	zypper --root "$TARGET" --non-interactive remove "${remove[@]}"
}

install_base() {
	log "installing the base system"
	local pattern=patterns-nekoawai-base
	local -a install_args=()
	[ "$PROFILE" != desktop ] || pattern="patterns-nekoawai-$DESKTOP"
	read -r -a install_args <<< "$ADDITIONAL_PACKAGES $GPU_PACKAGES"
	# Bootstrap repositories exist for the duration of the install only; in
	# the finished system repositories belong to nekoawai-repos.
	zypper --root "$TARGET" --non-interactive --gpg-auto-import-keys \
		addrepo --refresh "$NEKO_CORE_REPO" nekoawai-bootstrap
	if [ -d "$NEKO_TARGET_REPO" ]; then
		zypper --root "$TARGET" --non-interactive \
			addrepo --no-gpgcheck --priority 90 "dir:$NEKO_TARGET_REPO" nekoawai-local
	fi

	if [ "$PROFILE" = desktop ]; then
		zypper --root "$TARGET" --non-interactive --gpg-auto-import-keys \
			install "$pattern" "${install_args[@]}"
	else
		zypper --root "$TARGET" --non-interactive --gpg-auto-import-keys \
			install --no-recommends "$pattern" "${install_args[@]}"
	fi
	normalize_gpu_packages

	zypper --root "$TARGET" --non-interactive removerepo nekoawai-bootstrap
	if [ -d "$NEKO_TARGET_REPO" ]; then
		zypper --root "$TARGET" --non-interactive removerepo nekoawai-local
	fi
	zypper --root "$TARGET" --non-interactive clean --all
}

keep_own_packages() {
	log "distribution packages in the system"
	# Without a repository of their own the nekoawai-* packages are orphans
	# and the first `zypper dup` removes them; see nekoawai-repos.
	[ -d "$NEKO_TARGET_REPO" ] || return 0
	install -dm 0755 "$TARGET/var/lib/nekoawai/repo"
	cp -p "$NEKO_TARGET_REPO"/*.rpm "$TARGET/var/lib/nekoawai/repo/"
}

apply_service_policy() {
	log "service policy"
	local display_manager
	# A preset takes effect in %post of the package that brought the unit,
	# and systemd, getty and dbus-broker arrive in the same transaction as
	# nekoawai-systemd-presets, usually before it. So apply the policy
	# separately, to the whole root at once.
	systemctl --root="$TARGET" preset-all
	if [ "$PROFILE" = desktop ]; then
		case $DESKTOP in
		niri | xfce) display_manager=lightdm.service ;;
		hyprland | plasma) display_manager=sddm.service ;;
		gnome) display_manager=gdm.service ;;
		esac
		systemctl --root="$TARGET" enable "$display_manager"
		systemctl --root="$TARGET" set-default graphical.target
	else
		systemctl --root="$TARGET" set-default multi-user.target
	fi
	if [ "$ENABLE_SSH" = yes ]; then
		systemctl --root="$TARGET" enable sshd.service
		chroot "$TARGET" firewall-offline-cmd --quiet --service=ssh
	else
		systemctl --root="$TARGET" disable sshd.service 2>/dev/null || :
		chroot "$TARGET" firewall-offline-cmd --quiet --remove-service=ssh 2>/dev/null || :
	fi
}

bind_system_mounts() {
	local dir
	# Everything that runs inside the target with chroot needs these, from
	# firewall-offline-cmd to dracut and sdbootutil, so they go up before the
	# first of them rather than before the last. Earlier is not possible: the
	# mount points themselves arrive with the base.
	for dir in /proc /sys /dev /run; do
		mount --rbind "$dir" "$TARGET$dir"
		mount --make-rslave "$TARGET$dir"
	done
}

write_fstab() {
	log "fstab"
	local root_options=defaults
	[ "$FSTYPE" = btrfs ] && root_options=subvol=@

	cat > "$TARGET/etc/fstab" <<-EOF
		UUID=$ROOT_UUID  /          $FSTYPE  $root_options  0 1
		UUID=$ESP_UUID  /boot/efi  vfat     umask=0077     0 2
	EOF

	if [ "$ENCRYPT" = yes ]; then
		printf 'cr_root UUID=%s none luks\n' "$ROOT_PART_UUID" > "$TARGET/etc/crypttab"
	fi
}

configure_swap() {
	local swap_path=/swap/swapfile
	case $SWAP_MODE in
	zram)
		rm -f "$TARGET/etc/systemd/zram-generator.conf"
		;;
	none)
		install -Dm 0644 /dev/null "$TARGET/etc/systemd/zram-generator.conf"
		;;
	swapfile)
		install -Dm 0644 /dev/null "$TARGET/etc/systemd/zram-generator.conf"
		if [ "$FSTYPE" = btrfs ]; then
			# The area has to be nocow, uncompressed and free of
			# preallocated extents; mkswapfile is what gets all three
			# right on its own.
			btrfs subvolume create "$TARGET/swap" >/dev/null
			btrfs filesystem mkswapfile --size "$SWAP_SIZE" "$TARGET$swap_path" >/dev/null
		else
			mkdir -p "$TARGET/swap"
			# mkswap creates the file itself: a file left by fallocate
			# keeps unwritten extents, and swapon skips those as holes.
			mkswap --size "$SWAP_SIZE" --file "$TARGET$swap_path" >/dev/null
		fi
		chmod 0600 "$TARGET$swap_path"
		printf '%s none swap defaults 0 0\n' "$swap_path" >> "$TARGET/etc/fstab"
		;;
	esac
}

configure_network() {
	local source=/etc/NetworkManager/system-connections
	[ "$NETWORK_MODE" = copy ] || return 0
	[ -d "$source" ] || return 0
	install -dm 0700 "$TARGET$source"
	cp -a "$source"/. "$TARGET$source"/
	find "$TARGET$source" -type f -exec chmod 0600 {} +
}

configure_system() {
	log "system configuration"
	local index password_hash groups
	if [ "$TUI" != yes ]; then
		LOCALE=$(ask "locale" en_US.UTF-8)
		# Ask for the keymap before any password: under the wrong layout the
		# password typed is not the one intended, and that only surfaces at the
		# first login.
		KEYMAP=$(ask "console keymap" us)
		TIMEZONE=$(ask "time zone" UTC)
		HOSTNAME=$(ask "machine name" nekoawai)
		ROOT_PASSWORD=$(ask_secret "root password")
	fi

	systemd-firstboot --root="$TARGET" --force \
		--locale="$LOCALE" --timezone="$TIMEZONE" --hostname="$HOSTNAME" \
		--keymap="$KEYMAP"

	# Set the password as a hash through usermod rather than chpasswd:
	# chpasswd and passwd are labelled passwd_exec_t, and on a SELinux
	# machine that domain may not chroot into the target root. usermod runs
	# in a domain that may.
	if [ "$ROOT_LOCKED" = yes ]; then
		usermod --root "$TARGET" --lock root
	else
		password_hash=$(printf '%s' "$ROOT_PASSWORD" | openssl passwd -6 -stdin)
		usermod --root "$TARGET" --password "$password_hash" root
	fi

	for index in "${!USER_NAMES[@]}"; do
		groups=
		[ "${USER_WHEEL[$index]}" != yes ] || groups=wheel
		if [ -n "$groups" ]; then
			useradd --root "$TARGET" --create-home --shell /bin/bash --groups "$groups" "${USER_NAMES[$index]}"
		else
			useradd --root "$TARGET" --create-home --shell /bin/bash "${USER_NAMES[$index]}"
		fi
		password_hash=$(printf '%s' "${USER_PASSWORDS[$index]}" | openssl passwd -6 -stdin)
		usermod --root "$TARGET" --password "$password_hash" "${USER_NAMES[$index]}"
	done
	ROOT_PASSWORD=
	USER_PASSWORDS=()
}

build_initramfs() {
	log "initramfs"
	# Not hostonly: the installer does not run on the machine the system will
	# live on, and an image built for the hardware here would find neither
	# disk nor root there.
	chroot "$TARGET" dracut --force --no-hostonly --regenerate-all
}

install_bootloader() {
	log "systemd-boot"
	local options efi_flags=

	# sdbootutil refuses to run at all without a real efivarfs. Where there
	# is none, leave the variables alone: the fallback BOOTX64.EFI on the ESP
	# boots the machine without an NVRAM entry.
	[ "$(findmnt -no FSTYPE /sys/firmware/efi/efivars 2>/dev/null)" = efivarfs ] ||
		efi_flags=--no-variables

	options="root=UUID=$ROOT_UUID rw quiet loglevel=3"
	[ "$FSTYPE" = btrfs ] && options="$options rootflags=subvol=@"
	[ "$ENCRYPT" = yes ] && options="rd.luks.uuid=$ROOT_PART_UUID $options"

	# The kernel package scriptlet reads the command line from here on every
	# update, so it lives in the system and not only in the ESP entry.
	install -dm 0755 "$TARGET/etc/kernel"
	printf '%s\n' "$options" > "$TARGET/etc/kernel/cmdline"

	# sdbootutil lays out the ESP, and the kernel package scriptlet calls it
	# again on every kernel update.
	chroot "$TARGET" sdbootutil $efi_flags install
	chroot "$TARGET" sdbootutil $efi_flags add-all-kernels

	# `sdbootutil set-timeout` writes the LoaderConfigTimeout EFI variable,
	# which goes nowhere without efivarfs. loader.conf always survives.
	printf 'timeout 3\n' >> "$TARGET/boot/efi/loader/loader.conf"
}

save_install_profile() {
	# 0600: the file records the layout and whether the root is encrypted.
	local users
	users=$(IFS=,; printf '%s' "${USER_NAMES[*]}")
	{
		printf 'DISK=%q\n' "$DISK"
		printf 'FSTYPE=%q\n' "$FSTYPE"
		printf 'ENCRYPT=%q\n' "$ENCRYPT"
		printf 'PROFILE=%q\n' "$PROFILE"
		printf 'DESKTOP=%q\n' "$DESKTOP"
		printf 'SWAP_MODE=%q\n' "$SWAP_MODE"
		printf 'LOCALE=%q\n' "$LOCALE"
		printf 'KEYMAP=%q\n' "$KEYMAP"
		printf 'TIMEZONE=%q\n' "$TIMEZONE"
		printf 'HOSTNAME=%q\n' "$HOSTNAME"
		printf 'NETWORK_MODE=%q\n' "$NETWORK_MODE"
		printf 'ENABLE_SSH=%q\n' "$ENABLE_SSH"
		printf 'USERS=%q\n' "$users"
	} > "$TARGET/etc/nekoawai/install.conf"
	chmod 0600 "$TARGET/etc/nekoawai/install.conf"
}

unmount_target() {
	# A plain umount fails while anything still holds the tree, and the
	# leftover is then a mount of /run and /dev inside /mnt -- which is
	# exactly what a shutdown trips over afterwards. Detaching it lazily
	# leaves nothing behind for systemd to unmount at reboot.
	umount -R "$TARGET" 2>/dev/null || umount -Rl "$TARGET" 2>/dev/null || :
	[ "$ENCRYPT" = yes ] && cryptsetup close cr_root 2>/dev/null || :
}

# `systemctl reboot` hands systemd a job and comes straight back: whether the
# machine goes down is systemd's business, and one stuck job is enough for it
# never to happen -- which looks exactly like an installer that ignored the
# answer. So the wait is bounded. The second attempt skips the job queue and
# calls reboot(2) itself, and by then there is nothing to lose: the target is
# unmounted and the Live root lives in memory.
reboot_now() {
	printf '\nRebooting. Take the installation medium out.\n'
	systemctl reboot || :
	sleep 15
	printf 'systemd is taking its time. Rebooting the hard way.\n'
	sync
	systemctl --force --force reboot || :
	sleep 5
	printf 'The machine did not reboot. Power it off by hand: the system on %s is complete.\n' \
		"$DISK"
}

# A step that runs for minutes looks the same as a machine that has stopped.
# The number says how much is left, and the time it took says the wait was
# real work.
run_step() {
	local started=$SECONDS
	CURRENT_STEP=$1
	shift
	STEP_INDEX=$(( STEP_INDEX + 1 ))
	[ "$TUI" != yes ] || printf '\n%s[%2d/%d]%s %s\n' \
		"$TUI_BRAND" "$STEP_INDEX" "$STEP_TOTAL" "$TUI_PLAIN" "$CURRENT_STEP"
	"$@"
	[ "$TUI" != yes ] || printf '%s        took %ss%s\n' \
		"$TUI_DIM" "$(( SECONDS - started ))" "$TUI_PLAIN"
}

installation_failed() {
	local status=$?
	trap - ERR
	# Descriptor 3 is the terminal itself. The rest of the run goes through
	# tee, and the one line that must not be lost to its buffer is this one.
	printf '\n%sStep %s of %s failed: %s%s\n' \
		"$TUI_WARN" "$STEP_INDEX" "$STEP_TOTAL" "${CURRENT_STEP:-unknown}" "$TUI_PLAIN" >&3
	printf 'Nothing further was written. The whole run is in %s\n' "$INSTALL_LOG" >&3
	exit "$status"
}

usage() {
	cat <<-EOF
		Usage: nekoawai-install [--text]

		Interactive NekoAwai system installer.
		  --text       use the line-oriented fallback for automated tests
		  -h, --help   show this help
		  -V, --version
	EOF
}

main() {
	local force_text=no started=0 minutes
	while [ "$#" -gt 0 ]; do
		case $1 in
		--text) force_text=yes ;;
		-h | --help) usage; return ;;
		-V | --version) printf 'nekoawai-install %s\n' "$VERSION"; return ;;
		*) die "unknown argument: $1" ;;
		esac
		shift
	done

	require_uefi_root
	exec 3>&2
	if [ "$force_text" = no ] && [ -t 0 ] && [ -t 1 ]; then
		TUI=yes
		configure_tui
	else
		select_disk
		select_layout
		confirm_wipe
	fi

	trap unmount_target EXIT
	trap installation_failed ERR
	: > "$INSTALL_LOG"
	detect_gpu_packages
	started=$SECONDS

	if [ "$TUI" = yes ]; then
		tui_screen "Installing ${DESKTOP:-$PROFILE} NekoAwai on $DISK.
Everything below also goes to $INSTALL_LOG"
		# On screen and in the log at once. The package step runs for minutes,
		# and a screen that shows nothing while it works cannot be told apart
		# from a machine that has stopped.
		exec > >(tee -a "$INSTALL_LOG") 2>&1
	fi

	# Keep in step with the run_step calls below.
	STEP_TOTAL=15
	run_step "Partitioning $DISK" partition_disk
	run_step "Setting up LUKS2" open_encrypted_root
	run_step "Creating filesystems" format_filesystems
	run_step "Mounting the target" mount_target
	run_step "Installing packages" install_base
	run_step "Binding /proc, /sys, /dev and /run" bind_system_mounts
	run_step "Keeping the NekoAwai repository" keep_own_packages
	run_step "Applying the systemd policy" apply_service_policy
	run_step "Writing fstab" write_fstab
	run_step "Setting up swap" configure_swap
	run_step "Configuring the system and users" configure_system
	run_step "Configuring the network" configure_network
	run_step "Building the initramfs" build_initramfs
	run_step "Installing systemd-boot" install_bootloader
	run_step "Saving the installation profile" save_install_profile

	trap - ERR
	trap - EXIT
	unmount_target
	minutes=$(( (SECONDS - started + 59) / 60 ))

	if [ "$TUI" = yes ]; then
		if tui_confirm "NekoAwai is on $DISK, ${DESKTOP:-$PROFILE} profile, $minutes min.
Take the installation medium out before the machine comes back up.

Reboot now?" yes; then
			# The reboot prints to the screen, and the screen at this point
			# is the menu's. Give it back before writing on it.
			tui_screen "Installation finished."
			reboot_now
		fi
	else
		log "installation finished"
		# An `&&` list here would make a declined reboot the exit status of a
		# successful install.
		if [ "$(ask "reboot now (yes/no)" yes)" = yes ]; then
			reboot_now
		fi
	fi
}

# scripts/make-rootfs.sh sources this file to unpack the base with the same
# steps, so run the interactive install only when executed directly.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	main "$@"
fi
